# ---------------------------------------------------------------------------
# Copy to `.env` and edit. Nothing secret is committed; the app runs with ZERO
# keys by default (yfinance primary, key-free Nasdaq/FRED fallback).
# ---------------------------------------------------------------------------

# --- App / database ---------------------------------------------------------
DEBUG=false
DATABASE_URL=sqlite:///./data/stock_advisor.db

# --- Market data ------------------------------------------------------------
# auto = try each configured provider in order until one returns real data.
# Other values: yfinance | nasdaq | fred
MARKET_DATA_PROVIDER=auto
MIN_PROVIDER_INTERVAL_SECONDS=1.2
MAX_RETRIES=4
BACKOFF_BASE_SECONDS=1.0
PROVIDER_TIMEOUT_SECONDS=20

# Optional keyed providers - add a key here and it is picked up automatically.
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
POLYGON_API_KEY=

# --- Universe / benchmark ---------------------------------------------------
BENCHMARK_SYMBOL=^GSPC
VIX_SYMBOL=^VIX
UNIVERSE_SIZE=100

# --- Paper trading ----------------------------------------------------------
INITIAL_CASH=100000
COMMISSION_PER_SHARE=0.00
MIN_COMMISSION=0.00
SLIPPAGE_BPS=5
SHORT_BORROW_APY=0.03
RISK_PER_TRADE_PCT=1.0

# --- Scheduling / alerts ----------------------------------------------------
SCHEDULER_ENABLED=true
# Fresh database: load the universe, fetch prices and screen at startup.
AUTO_SETUP=true
NIGHTLY_CRON=15 21 * * *
ALERT_DEFAULT_DRAWDOWN_PCT=10
ALERT_DEFAULT_EARNINGS_WITHIN_DAYS=14
